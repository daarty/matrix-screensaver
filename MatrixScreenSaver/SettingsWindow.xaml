<Window x:Class="MatrixScreenSaver.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matrix Screensaver Settings"
        Width="420"
        Icon="Resources/MatrixScreenSaver.ico"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Character size" />
        <DockPanel Margin="0,4,0,0">
            <TextBlock Width="40"
                       DockPanel.Dock="Right"
                       Text="{Binding Value, ElementName=CharacterSizeSlider}"
                       TextAlignment="Right" />
            <Slider x:Name="CharacterSizeSlider"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1" />
        </DockPanel>

        <TextBlock Margin="0,16,0,0" Text="Density (new drops per column and minute)" />
        <DockPanel Margin="0,4,0,0">
            <TextBlock Width="40"
                       DockPanel.Dock="Right"
                       Text="{Binding Value, ElementName=DensitySlider}"
                       TextAlignment="Right" />
            <Slider x:Name="DensitySlider"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1" />
        </DockPanel>

        <TextBlock Margin="0,16,0,4" Text="Character sets" />
        <WrapPanel x:Name="CharacterSetPanel" />

        <StackPanel Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="80"
                    Click="DefaultsClick"
                    Content="Defaults" />
            <Button Width="80"
                    Margin="8,0,0,0"
                    Click="OkClick"
                    Content="OK"
                    IsDefault="True" />
            <Button Width="80"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
