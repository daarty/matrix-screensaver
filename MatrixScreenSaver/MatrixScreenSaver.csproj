<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>MatrixScreenSaver</RootNamespace>
    <AssemblyName>MatrixScreenSaver</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\MatrixScreenSaver.ico</ApplicationIcon>

    <Company>daarty</Company>
    <Product>MatrixScreenSaver</Product>
    <Trademark>daarty</Trademark>
    <Copyright>Copyright © 2026 daarty</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\MatrixScreenSaver.ico" />
  </ItemGroup>

  <!-- Windows only offers .scr files as screensavers. -->
  <Target Name="CopyAsScreenSaver" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(AssemblyName).scr" />
  </Target>

</Project>
